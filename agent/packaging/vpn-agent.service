[Unit]
Description=VPN Control Panel node agent (vpn-agent)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=/root
ExecStart=/root/config/vpn/bin/vpn-agent serve --base /root/config/vpn
Restart=always
RestartSec=5s
TimeoutStopSec=20s
# Files created by the agent are only accessible to root.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
# The base directory lives under the root home directory.
ProtectHome=no
ReadWritePaths=/root/config/vpn
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# systemctl talks to PID 1 over a unix socket; nft/ufw use netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
