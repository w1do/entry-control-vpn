# =============================================================================
# VPN Control Panel — переменные окружения (шаблон).
#
# Скопируйте файл и замените все значения вида <...>:
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# В Dokploy: Compose-сервис -> Environment -> вставьте содержимое уже
# заполненного deploy/.env -> Save -> Deploy (redeploy обязателен,
# Dokploy не пробрасывает переменные в уже запущенный контейнер).
# Контейнер получает этот файл через env_file: .env в docker-compose.yml.
#
# НАСТОЯЩИЙ deploy/.env никогда не коммитится (.gitignore). Здесь — только
# плейсхолдеры и команды генерации. Требования к значениям проверяются в
# backend/app/core/config.py при старте (понятная ошибка, без запуска HTTP).
# =============================================================================

# -----------------------------------------------------------------------------
# Администратор (единственный пользователь, регистрации нет)
# -----------------------------------------------------------------------------
# ADMIN — email для входа. PASSWORD — bootstrap-пароль, применяется ТОЛЬКО
# при первом старте на пустой БД; дальше он хранится хешем и менять его надо
# в панели (Настройки -> Сменить пароль), а не в .env.
# Минимум 12 символов; при более коротком в UI будет предупреждение.
ADMIN=admin@example.com
PASSWORD=<CHANGE_ME_strong_password_min_12_chars>

# -----------------------------------------------------------------------------
# Секреты панели
# -----------------------------------------------------------------------------
# SECRET_KEY — подпись серверных сессий и CSRF. Смена значения инвалидирует
# все активные сессии (это штатный способ «выкинуть всех»).
# Сгенерировать (на любой машине с openssl/python3):
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Ожидаемый вид: 64 hex-символа. Плейсхолдер ниже намеренно отвергается
# валидатором — приложение не стартует, пока ключ не заменён.
SECRET_KEY=change-me-to-a-random-64-hex

# ENCRYPTION_KEY — ключ Fernet для шифрования секретов в БД:
# SSH-пароли и приватные ключи узлов, interconnect-ключи REALITY, agent-токены.
# Сгенерировать (ровно один из вариантов):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   openssl rand -base64 32 | tr '+/' '-_'
# Ожидаемый вид: 44 символа base64url (32 байта), с завершающим '='.
# ВАЖНО: без этого ключа сохранённые секреты не расшифровать. Сохраните его
# в менеджере секретов отдельно от резервных копий БД.
ENCRYPTION_KEY=<CHANGE_ME_44_char_urlsafe_base64_fernet_key>

# METRICS_TOKEN — Bearer-токен для GET /metrics (Prometheus-скрейпинг).
# Пустое значение = эндпоинт недоступен (закрыт). Не храните токен в URL.
# Сгенерировать: openssl rand -hex 32
METRICS_TOKEN=

# -----------------------------------------------------------------------------
# Панель
# -----------------------------------------------------------------------------
# Публичный адрес панели без завершающего слэша. Нужен агентам узлов
# (register/heartbeat/config) и подпискам клиентов (/sub/<token>).
PUBLIC_BASE_URL=https://panel.example.com

# -----------------------------------------------------------------------------
# База данных
# -----------------------------------------------------------------------------
# SQLite (по умолчанию, один контейнер): файл на постоянном томе /data.
#   sqlite+aiosqlite:////data/app.db   (четыре слэша — абсолютный путь)
# PostgreSQL (опционально, profile postgres): схема postgresql+asyncpg://
#   postgresql+asyncpg://vpn:<POSTGRES_PASSWORD>@db:5432/vpn
# Не меняйте /data на другой путь: docker-compose монтирует том panel-data
# именно в /data.
DATABASE_URL=sqlite+aiosqlite:////data/app.db

# -----------------------------------------------------------------------------
# Безопасность и окружение
# -----------------------------------------------------------------------------
# Cookie сессии Secure: true — только HTTPS (продакшен за Traefik).
# false допустимо только для локальной разработки по http://localhost,
# иначе браузер не сохранит cookie и вход будет «возвращаться» на login.
SESSION_COOKIE_SECURE=true

# Часовой пояс контейнера (логи, расписания APScheduler). В БД время всегда UTC.
TZ=UTC

# -----------------------------------------------------------------------------
# Необязательные параметры (ниже — значения по умолчанию; обычно не трогают)
# -----------------------------------------------------------------------------
# APP_ENV=production
# LOG_LEVEL=INFO
# SESSION_TTL_SECONDS=604800
# COOKIE_NAME=           # пусто = __Host-vpn_session при SESSION_COOKIE_SECURE=true
# DATA_DIR=/data
# ARTIFACTS_DIR=/data/artifacts
# STATIC_DIR=            # пусто = app/static (собранный SPA внутри образа)
# AUTO_CREATE_SCHEMA=false # true только для локальной разработки без миграций
# XRAY_VERSION=26.11.9
# AGENT_VERSION=0.1.0
# HEARTBEAT_OFFLINE_SECONDS=90
# EXIT_HEALTH_INTERVAL_SECONDS=30
# SCHEDULER_ENABLED=true

# =============================================================================
# PostgreSQL — только для profile postgres (docker compose --profile postgres).
# Для SQLite этот блок не нужен; строки ниже закомментированы.
# =============================================================================
# POSTGRES_DB=vpn
# POSTGRES_USER=vpn
# POSTGRES_PASSWORD=<CHANGE_ME_postgres_password_latin_digits_only>
# DATABASE_URL=postgresql+asyncpg://vpn:<CHANGE_ME_postgres_password_latin_digits_only>@db:5432/vpn