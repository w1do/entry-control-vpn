# Единственный администратор (bootstrap при первом запуске).
# ВАЖНО: в .env.example НЕ должно быть реальных секретов — только плейсхолдеры.
ADMIN=<admin-email>
PASSWORD=<strong-password-min-12-chars>

# Секреты панели. Сгенерировать:
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   METRICS_TOKEN:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<64-hex>
ENCRYPTION_KEY=<fernet-key>
METRICS_TOKEN=<random-token>

# Публичный адрес панели (для агентов и подписок)
PUBLIC_BASE_URL=https://vpn.example.com

# БД: SQLite на томе или внешний Postgres
DATABASE_URL=sqlite+aiosqlite:////data/app.db
